<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic HealthKit — supported on Personal Team (free) and Paid.
         Lets us read HR, SpO2, steps, sleep, body temp, HRV from
         Apple Health (which itself aggregates from Apple Watch,
         Whoop, Garmin, Fitbit, Oura, Polar, etc.).

         NOT included intentionally:
           com.apple.developer.healthkit.access
         That entitlement is for Verifiable Health Records (FHIR /
         clinical records) and requires a paid Apple Developer Program
         membership. We don't need clinical records to read vitals. -->
    <key>com.apple.developer.healthkit</key>
    <true/>
</dict>
</plist>
